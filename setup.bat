@echo off
echo ============================================================
echo  SensiExtractor - First-time setup
echo ============================================================
echo.
echo Everything will be downloaded into this folder:
echo   .\env\        Python environment (~2 GB)
echo   .\mfa_data\   MFA acoustic models (~1 GB)
echo   .\hf_cache\   GPT-2 weights (~500 MB, on first run)
echo.
echo Run this from Anaconda Prompt. Press Ctrl+C to cancel.
echo.
pause

echo.
echo [1/5] Installing conda-lock (deterministic installer) ...
call conda install -n base -c conda-forge conda-lock -y
if errorlevel 1 (
    echo.
    echo ERROR: conda install -n base -c conda-forge conda-lock failed.
    echo Make sure you are running this from Anaconda Prompt.
    pause
    exit /b 1
)

echo.
echo [2/5] Creating .\env from conda-lock.yml (exact, pinned versions) ...
rem conda-lock.yml pins every package for this platform. CPU Kaldi is pinned in
rem environment.yml; the lock captures it exactly.
call conda-lock install -p .\env conda-lock.yml
if errorlevel 1 (
    echo.
    echo ERROR: conda-lock install failed.
    pause
    exit /b 1
)

echo.
echo [3/5] Downloading MFA models into .\mfa_data ...
call conda run --prefix .\env python utils\download_models.py

echo.
echo [4/5] Downloading spaCy model into .\env ...
call conda run --prefix .\env python -m spacy download en_core_web_sm

echo.
echo [5/5] Creating the double-click launcher (runGUI.bat) ...
rem Bake in the conda base path we just used, so a double-clicked launcher (which
rem does NOT run through Anaconda Prompt) can still find and activate conda.
rem Regenerated on every setup; machine-specific, so it is git-ignored.
for /f "delims=" %%i in ('conda info --base') do set "CONDA_BASE=%%i"
(
    echo @echo off
    echo rem Auto-generated by setup.bat - double-click to launch SensiExtractor. Not committed.
    echo cd /d "%%~dp0"
    echo call "%CONDA_BASE%\Scripts\activate.bat" "%%~dp0env"
    echo start "" "%%~dp0env\pythonw.exe" gui.py
) > runGUI.bat
echo   Created runGUI.bat - double-click it (in File Explorer) to launch the GUI.

echo.
echo ============================================================
echo  Setup complete!
echo.
echo  To launch the app, either:
echo    - double-click  runGUI.bat  (in File Explorer), or
echo    - conda activate .\env  ^&^&  python gui.py
echo ============================================================
pause
