env/
# Downloaded models (data/; the pre-2026-10-27 top-level names too, until moved)
data/mfa_data/
data/hf_cache/
data/gensim_data/
/mfa_data/
/hf_cache/
/gensim_data/
__pycache__/
*.pyc
*.csv

# Editor / agent configs (local, not project state)
.claude/
.vscode/
.idea
.mcp.json

# Test artifacts
.pytest_cache/
htmlcov/
*.egg-info/

# Runtime config (license-bound or user-specific)
config/preferences.json
config/preferences.json.bak
config/features.yaml
config/run.yaml
config/hf_token.txt
# machine-local learning data for the Run-tab time estimate (sensi/utils/timing_history.py)
config/timing_history.json
# belt-and-braces: token file must never be trackable wherever it lands under env overrides
hf_token.txt
data/dictionaries/*.dic
data/dictionaries/*.parquet
data/dictionaries/*.csv

# ...but DO track the freely-redistributable lexical-norm tables built by
# download_lexical_norms.py (EWFG/MRC and any other local files stay ignored).
!data/dictionaries/aoa_kuperman.parquet
!data/dictionaries/aoa_kuperman.csv
!data/dictionaries/concreteness_brysbaert.parquet
!data/dictionaries/concreteness_brysbaert.csv
!data/dictionaries/warriner_vad.parquet
!data/dictionaries/warriner_vad.csv
!data/dictionaries/mrc.parquet
!data/dictionaries/mrc.csv

# Double-click launcher generated by setup.sh / setup.bat (machine-specific
# conda path; regenerate by re-running setup)
runGUI.command
runGUI.sh
runGUI.bat
SensiExtractor.lnk
SensiExtractor.desktop

# Run outputs
output/

# Development material kept local: scratch work, validation corpus and runs,
# audit working files, the owner's notes, and Claude Code's project file
# (CLAUDE.md stays on disk at the root, where Claude Code reads it).
dev/unrelated/
dev/audit/
dev/validation/*
!dev/validation/verify_phoneme_batch.py
dev/in_app_documentation_needs_fix.md
CLAUDE.md
# pre-2026-10-27 locations of the same
/unrelated/
/validation/
/audit/

# Provo validation cache
data/provo/

# Sherlock: built Apptainer container image (3-4 GB, regenerable from Apptainer.def)
sherlock/*.sif
# Apptainer build scratch (writable sandbox dirs + interrupted-build leftovers)
sherlock/build-temp-*/
sherlock/*_sandbox/
SensiExtractor.app/
